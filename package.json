{
  "name": "monorepo-code-coverage-reporter",
  "version": "1.8.0",
  "description": "A comprehensive coverage reporter for monorepos",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.js -o dist --source-map --license licenses.txt",
    "test": "jest",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "configure-repo": "zx scripts/configure-repo.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MatloobAltaf/monorepo-code-coverage-reporter.git"
  },
  "bugs": {
    "url": "https://github.com/MatloobAltaf/monorepo-code-coverage-reporter/issues"
  },
  "homepage": "https://github.com/MatloobAltaf/monorepo-code-coverage-reporter#readme",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "github-actions",
    "coverage",
    "nx",
    "monorepo",
    "json",
    "javascript"
  ],
  "author": "Matloob Altaf",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@clack/prompts": "^1.5.1",
    "@vercel/ncc": "^0.38.1",
    "jest": "^29.7.0",
    "zx": "^8.8.5"
  }
}
